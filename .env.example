PORT=5000
NODE_ENV=development
# MongoDB Atlas (or any replica set). Transactions REQUIRE a replica set.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/veloop_wallet?retryWrites=true&w=majority
# Use a long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Frontend origin(s) allowed by CORS, comma separated
CLIENT_URL=http://localhost:5173
# Number of trusted reverse-proxy hops (leave 0 unless deployed behind a proxy)
TRUST_PROXY=0
# Fraud rule: max non-rejected withdrawals per user per 24h
MAX_WITHDRAWALS_PER_DAY=3
# Daily reward amount in VEs
DAILY_REWARD_VES=100
# Demo rewarded ads: VE reward, daily claim cap, and minimum ad duration
AD_REWARD_VES=25
AD_REWARD_DAILY_LIMIT=5
AD_WATCH_DURATION_SECONDS=15
# Referral reward paid to the inviter for each successful signup
REFERRAL_REWARD_VES=500
# Demo mining: reward rate, minimum interval between claims, and session cap
MINING_RATE_VES_PER_MINUTE=10
MINING_CLAIM_INTERVAL_SECONDS=60
MINING_MAX_DURATION_HOURS=8
# Demo number-guess game reward and attempt limits
GAME_REWARD_VES=25
GAME_MAX_ATTEMPTS=3
GAME_CHALLENGE_TTL_MINUTES=10
